<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Produces packages.lock.json (#123). Two reasons: GitHub's dependency graph parses the
         csproj and therefore only ever saw our DIRECT references — Microsoft.OpenApi, which
         carries a high-severity advisory, was invisible to Dependabot because it arrives
         transitively via Swashbuckle. A lock file gives GitHub the resolved graph so
         transitive advisories can actually be alerted on. It also pins transitive versions,
         so a CI restore resolves exactly what a local one did. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- Audit the whole graph, not just direct references, and FAIL on it (#123). The
         Microsoft.OpenApi advisory sat in build output as a warning for weeks and was only
         noticed while reading a deploy log for an unrelated reason. A high-severity finding
         should stop the build, not scroll past. NU1901-1904 are the audit severities. -->
    <NuGetAuditMode>all</NuGetAuditMode>
    <WarningsAsErrors>$(WarningsAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsAsErrors>
    <UserSecretsId>72a2829d-5f40-4252-a061-b71d55ebfc5c</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Storage.Blobs" Version="12.29.2" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
<PackageReference Include="Microsoft.Azure.SignalR" Version="1.33.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

</Project>
